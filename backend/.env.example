# ==============================================================================
# AGRISENSE ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Flask Server Config
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0
SECRET_KEY=agrisense-secret-key-change-this-in-production

# Supabase Project Credentials (from your Supabase Dashboard -> Settings -> API)
# URL example: https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
# Anon / Public Key (safe to use in frontend and backend requests)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (NEVER expose to frontend; used by backend for elevated tasks/migrations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Bucket for Crop & Leaf Photos
SUPABASE_STORAGE_BUCKET=crop-images

# Weather API (Optional - defaults to Open-Meteo free live API if left empty)
OPENWEATHER_API_KEY=

# AI Chatbot / AgriBot LLM API Key (e.g., Gemini API, Groq, or OpenAI)
# Optional - defaults to domain knowledge engine if not configured
GEMINI_API_KEY=
